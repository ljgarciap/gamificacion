server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # Los archivos de Flutter Web NO llevan hash en el nombre (main.dart.js, fuentes, íconos): con «inmutable» el navegador seguiría con la
  # versión vieja tras cada despliegue (síntoma: «no veo el cambio»). Se revalidan siempre (ETag: si no cambió, responde 304 sin bajar nada).
  # OJO: un add_header dentro de un location anula TODOS los del server; si se agrega otro location, repetir las cabeceras de seguridad.
  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache";
    add_header Content-Security-Policy "frame-ancestors ${ALLOWED_FRAME_ANCESTORS}" always;
    add_header X-Content-Type-Options "nosniff" always;
  }
}
