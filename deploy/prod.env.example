# Plantilla de variables de producción. Copiar a deploy/prod.env (NO versionar) y llenar desde el gestor de secretos.
# Lista de verificación completa: docs/hardening-p9.md.
APP_NAME=Gamificacion
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # php artisan key:generate --show
APP_URL=https://admin.ejemplo.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_PORT=5432
DB_PASSWORD=                  # la misma que usa el servicio db

# Sesión del panel (RNF-32): cookie solo por HTTPS, HttpOnly, SameSite=Lax (valor por defecto del código).
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# La inactividad real la fija GAMIF_ADMIN_SESSION_IDLE (minutos); SESSION_LIFETIME no la gobierna.
GAMIF_ADMIN_SESSION_IDLE=30
CACHE_STORE=database

# Motor de premios: generar con `php artisan gamification:keys --write` EN EL GESTOR DE SECRETOS, y respaldar GAMIF_PRIZE_MAP_KEY cifrada.
GAMIF_PRIZE_MAP_KEY=
GAMIF_CODE_PEPPER=
GAMIF_ADMIN_KEY=
GAMIF_BEACON=drand
DRAND_URL=https://api.drand.sh
DRAND_CHAIN=52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971
DRAND_MARGIN_SECONDS=60

# Hosts: se administran desde el panel, pero el emisor debe existir aquí (alg + clave de verificación).
GAMIF_HOSTS={}
GAMIF_TOKEN_AUDIENCE=gamification
GAMIF_FULFILLMENT=http
GAMIF_BALANCE=http

# OBLIGATORIO: la red del balanceador Y la de los contenedores nginx (si no, el bloqueo por IP lo comparte todo el mundo). «none» = sin proxy.
# En producción la app NO arranca si está vacía. «*» exige además GAMIF_TRUSTED_PROXIES_ALLOW_ALL=true.
GAMIF_TRUSTED_PROXIES=

# NO definir nunca en producción: GAMIF_DEV_ENDPOINTS, GAMIF_CORS_ORIGINS, GAMIF_HOST_ALLOW_LOCAL, GAMIF_DEMO_INITIAL_BALANCE.
