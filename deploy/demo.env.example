# Variables de la demostración (copiar a deploy/demo.env, NO versionar). Guía: docs/despliegue-demo.md.

# --- Dominio y compuerta (las usa Caddy) ---
DEMO_DOMAIN=demo.ejemplo.com
ADMIN_DOMAIN=admin.ejemplo.com
DEMO_USER=demo
# Hash bcrypt de la clave, entre comillas simples (lleva $): docker run --rm caddy:2-alpine caddy hash-password --plaintext 'tu-clave'
DEMO_PASSWORD_HASH='$2a$14$...'

# --- Base de datos ---
DB_CONNECTION=pgsql
DB_PORT=5432
DB_PASSWORD=

# --- Laravel ---
APP_NAME=Gamificacion
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # php artisan key:generate --show
APP_URL=https://demo.ejemplo.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database

# --- Motor de premios: generar con `php artisan gamification:keys --write` y respaldar GAMIF_PRIZE_MAP_KEY ---
GAMIF_PRIZE_MAP_KEY=
GAMIF_CODE_PEPPER=
GAMIF_ADMIN_KEY=
GAMIF_BEACON=drand
DRAND_URL=https://api.drand.sh
DRAND_CHAIN=52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971
DRAND_MARGIN_SECONDS=60

# --- MODO DEMO ---
GAMIF_DEMO_MODE=true
GAMIF_DEMO_INITIAL_BALANCE=200000
GAMIF_TOKEN_AUDIENCE=gamification
# Emisor de los tokens de demostración: la clave es 32 bytes aleatorios en base64 (openssl rand -base64 32). Solo para ESTE emisor.
GAMIF_HOSTS={"standalone-dev":{"alg":"HS256","key":"PON_AQUI_LA_CLAVE_BASE64"}}

# --- Proxies: Caddy y nginx viven en las redes privadas de Docker (obligatorio en producción) ---
GAMIF_TRUSTED_PROXIES=172.16.0.0/12

# NO definir: GAMIF_DEV_ENDPOINTS, GAMIF_CORS_ORIGINS (la web y la API comparten origen), GAMIF_HOST_ALLOW_LOCAL.
